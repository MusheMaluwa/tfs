# Local dev databases, seeded with demo data by `npm run seed` in
# backend/ — not source. Committing one would mean every developer
# inherits whatever fleet state the last person happened to leave behind.
#
# Nothing writes to these any more: the MongoDB version keeps its
# throwaway data in a temp directory the process deletes on exit. They
# are left over from the PostgreSQL (backend/.pgdata) and SQLite
# (*.db) versions this replaced, and stay ignored so an old working
# copy does not suddenly start offering to commit one.
backend/.pgdata/
backend/*.db
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm

node_modules/
.env
.env.local
.DS_Store
