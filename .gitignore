# Local dev databases, seeded with demo data by `npm run seed` in
# backend/ — not source. Committing one would mean every developer
# inherits whatever fleet state the last person happened to leave behind.
#
# backend/.pgdata is the embedded PostgreSQL (PGlite) data directory used
# when DATABASE_URL is unset; the *.db files are left over from the
# SQLite version this replaced.
backend/.pgdata/
backend/*.db
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm

node_modules/
.env
.env.local
.DS_Store
